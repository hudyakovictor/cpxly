# Added by Capexly. No working secrets here; no production data in development.
# Choose a distinct COMPOSE_PROJECT_NAME and SECRETS_DIR per environment.
COMPOSE_PROJECT_NAME=capexly-dev
SECRETS_DIR=./secrets/dev
APP_IMAGE=capexly-app:REPLACE_WITH_RELEASE_ID
DOMAIN=
ACME_EMAIL=
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Wrapper selector must be exported in the shell, not merely set in this file.
# CADDY_VARIANT=external-ca uses supplied certificate/key instead of ACME.
# Garage is dev-only and pinned in infra/garage/Dockerfile.
S3_BUCKET=capexly-synthetic
S3_REGION=us-east-1
S3_ENDPOINT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
DEFAULT_FROM_EMAIL=
